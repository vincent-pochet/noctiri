# Prepare Noctalia Greeter for this machine, before greetd starts.
#
# Two per-machine things the image cannot carry: the state directory, because
# build/90-cleanup.sh prunes /var, and the keyboard layout, because the
# greeter's compositor reads no locale1 state and falls back to "us" -- which
# turns a correct password into a PAM AUTH_ERR on any other layout.
#
# It runs on every boot rather than once: `localectl set-x11-keymap` has to
# reach the login screen too, and the script is a rewrite, not an append.
# GREETER_USER matches the `user` in /etc/greetd/config.toml; the vendor helper
# would otherwise guess it from the directory's owner, which does not exist yet.

[Unit]
Description=Prepare Noctalia Greeter for this machine
Documentation=https://docs.noctalia.dev
Before=greetd.service
After=local-fs.target systemd-localed.service
RequiresMountsFor=/var/lib

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=GREETER_USER=greetd
ExecStart=/usr/libexec/noctiri-greeter-setup.sh

[Install]
WantedBy=graphical.target
